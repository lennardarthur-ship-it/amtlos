# Superuser für Einrichtung und Tests (docker compose)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# API (apps/api)
UMGEBUNG=dev
DATABASE_URL=postgresql://api_user:amtlos@localhost:5432/amtlos
AUTH_MODUS=dev
DEV_JWT_SECRET=bitte-durch-einen-langen-zufallswert-ersetzen
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Produktion: AUTH_MODUS=oidc, OIDC_ISSUER=https://login.amtlos.de, OIDC_AUDIENCE=<client-id>
# Prometheus: METRIKEN_TOKEN=<mindestens 32 Zeichen>  (ohne Token ist GET /metriken abgeschaltet)

# Worker (apps/worker)
WORKER_DATABASE_URL=postgresql://worker_user:amtlos@localhost:5432/amtlos
# SMTP_URL=smtp://benutzer:passwort@smtp.example.org:587
