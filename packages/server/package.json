{
  "name": "@amtlos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testhilfen": {
      "types": "./dist/testhilfen.d.ts",
      "default": "./dist/testhilfen.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "migrieren": "node dist/cli.js migrieren",
    "katalog:importieren": "node dist/cli.js katalog-importieren"
  },
  "dependencies": {
    "@amtlos/fachlogik": "workspace:*",
    "@amtlos/fristen": "workspace:*",
    "@amtlos/marke": "workspace:*",
    "@amtlos/rules-engine": "workspace:*",
    "@amtlos/rules-schema": "workspace:*",
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@e-invoice-eu/core": "3.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "5.11.2",
    "node-html-parser": "6.1.13",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  },
  "bin": {
    "amtlos-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schriften"
  ]
}
