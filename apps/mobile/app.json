{
  "expo": {
    "name": "Amtlos",
    "slug": "amtlos",
    "scheme": "amtlos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#136f5b",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "de.amtlos.app",
      "supportsTablet": false
    },
    "android": {
      "package": "de.amtlos.app"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
