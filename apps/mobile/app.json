{
  "expo": {
    "name": "Amtlos",
    "slug": "amtlos",
    "scheme": "amtlos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#136f5b",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "de.amtlos.app",
      "supportsTablet": false
    },
    "android": {
      "package": "de.amtlos.app"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Amtlos nutzt Face ID, um deine Unterlagen vor fremdem Zugriff zu schützen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amtlos braucht Zugriff auf deine Fotos, damit du dein Logo für Rechnungen und Briefe auswählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ]
  }
}
