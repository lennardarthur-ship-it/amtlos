{
  "expo": {
    "name": "Amtlos",
    "slug": "amtlos",
    "scheme": "amtlos",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#136f5b",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "de.amtlos.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "de.amtlos.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash.png",
        "backgroundColor": "#136f5b"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#136f5b",
          "dark": {
            "backgroundColor": "#11171d"
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Amtlos nutzt Face ID, um deine Unterlagen vor fremdem Zugriff zu schützen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amtlos braucht Zugriff auf deine Fotos, damit du dein Logo für Rechnungen und Briefe auswählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ]
  }
}
